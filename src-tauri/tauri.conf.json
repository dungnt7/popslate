{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Popslate",
  "identifier": "io.github.dungnt7.popslate",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "popup",
        "url": "popup.html",
        "visible": false,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "width": 420,
        "height": 240,
        "resizable": false,
        "maximizable": false,
        "minimizable": false,
        "shadow": true,
        "additionalBrowserArgs": "--disable-features=msWebOOUI,msPdfOOUI,msSmartScreenProtection --disable-gpu",
        "title": "Popslate"
      },
      {
        "label": "settings",
        "url": "settings.html",
        "title": "Popslate Settings",
        "visible": false,
        "width": 400,
        "height": 280,
        "resizable": false,
        "center": true,
        "maximizable": false,
        "minimizable": false,
        "create": false,
        "additionalBrowserArgs": "--disable-features=msWebOOUI,msPdfOOUI,msSmartScreenProtection --disable-gpu"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.ico"
    ],
    "publisher": "dungnt7",
    "windows": {
      "nsis": {
        "installerHooks": "installer-hooks.nsh"
      }
    }
  }
}
